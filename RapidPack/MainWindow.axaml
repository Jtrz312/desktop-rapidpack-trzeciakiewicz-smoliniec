<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RapidPack.MainWindow"
        Title="RapidPack">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock FontSize="50" Padding="0,0,0,30">NADAJ PACZKE</TextBlock>
                <TextBox x:Name="HeightBox" Watermark="Wysokosc"/>
                <TextBox x:Name="WidthBox" Watermark="Szerokosc"/>
                <TextBox x:Name="DepthBox" Watermark="Glebokosc"/>
                <TextBox x:Name="WeightBox" Watermark="Waga"/>
                <CheckBox x:Name="ExpressBox">Expres (+15zl)</CheckBox>
                <ComboBox x:Name="DeliveryBox">
                        <ComboBoxItem>Standardowa</ComboBoxItem>
                        <ComboBoxItem>Ostroznie (Szklo)</ComboBoxItem>
                        <ComboBoxItem>Paleta</ComboBoxItem>
                </ComboBox>
                <Button Click="HandleCalculation">Wycen</Button>
        </StackPanel>
</Window>
